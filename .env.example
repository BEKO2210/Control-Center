# ============================================================================
# Clawbot Mission Control — Environment Variables
# Copy to `.env.local` and fill in. NEVER commit real keys.
# ============================================================================

# Anthropic API key used by the server-side AI proxy route (/api/ai).
#
# SECURITY: this is intentionally NOT prefixed with NEXT_PUBLIC_, so it stays
# server-only and never ships to the browser. When set, the AIBridge uses it
# for every request and the client-provided session key is ignored.
#
# Leave unset to run in backend-less local mode, where users paste their own
# key into the Setup Wizard (held in sessionStorage for that session only).
ANTHROPIC_API_KEY=
